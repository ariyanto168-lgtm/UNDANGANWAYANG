    <!-- JAVASCRIPT LOGIC & INTERACTION -->
    <script>
        // State & Data Default
        let invitationData = {
            groom: "Raden Dimas Prayoga, S.T.",
            bride: "Nyai Roro Dewi Sekar Kencana, S.Pd.",
            date: "Minggu, 15 November 2026",
            time: "08.00 WIB s.d. Selesai",
            location: "Pendopo Agung Keraton",
            address: "Jl. Pariwisata Budaya No. 1, Semarang, Jawa Tengah",
            bank: "1234567890",
            scriptUrl: ""
        };

        // Load LocalStorage jika ada
        if(localStorage.getItem('jawa_wayangan_data')) {
            invitationData = JSON.parse(localStorage.getItem('jawa_wayangan_data'));
            applyEditorDataToUI();
        }

        // Ambil parameter URL untuk nama tamu (misal ?to=Bapak+Budi)
        const urlParams = new URLSearchParams(window.location.search);
        const guestTo = urlParams.get('to');
        if(guestTo) {
            document.getElementById('guestBadge').innerText = decodeURIComponent(guestTo);
        }

        // Buka Undangan & Play Music
        function openInvitation() {
            const cover = document.getElementById('coverSection');
            cover.style.transform = 'translateY(-100%)';
            setTimeout(() => {
                cover.style.display = 'none';
            }, 700);

            const content = document.getElementById('invitationContent');
            content.classList.remove('opacity-0');

            // Tampilkan floating control
            document.getElementById('floatingControls').classList.remove('hidden');

            // Play Music
            const audio = document.getElementById('bgMusic');
            audio.play().catch(e => console.log("Autoplay blocked by browser"));
        }

        // Music Toggle
        let isPlaying = false;
        function toggleMusic() {
            const audio = document.getElementById('bgMusic');
            const icon = document.getElementById('musicIcon');
            if(audio.paused) {
                audio.play();
                icon.className = "fa-solid fa-music text-lg animate-pulse text-palaceBlack";
            } else {
                audio.pause();
                icon.className = "fa-solid fa-volume-xmark text-lg text-palaceBlack";
            }
        }

        // Auto Scroll Toggle
        let scrollInterval = null;
        let isScrolling = false;
        function toggleAutoScroll() {
            const scrollIcon = document.getElementById('scrollIcon');
            if(!isScrolling) {
                isScrolling = true;
                scrollIcon.className = "fa-solid fa-pause text-lg";
                scrollInterval = setInterval(() => {
                    window.scrollBy({ top: 1, behavior: 'smooth' });
                    if((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 10) {
                        stopAutoScroll();
                    }
                }, 30);
            } else {
                stopAutoScroll();
            }
        }
        function stopAutoScroll() {
            isScrolling = false;
            clearInterval(scrollInterval);
            document.getElementById('scrollIcon').className = "fa-solid fa-angles-down text-lg";
        }
        window.addEventListener('wheel', () => { if(isScrolling) stopAutoScroll(); });

        // Countdown Timer (Target: 15 Nov 2026)
        const targetDate = new Date("November 15, 2026 08:00:00").getTime();
        setInterval(() => {
            const now = new Date().getTime();
            const distance = targetDate - now;
            if(distance > 0) {
                document.getElementById('days').innerText = Math.floor(distance / (1000 * 60 * 60 * 24));
                document.getElementById('hours').innerText = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                document.getElementById('minutes').innerText = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                document.getElementById('seconds').innerText = Math.floor((distance % (1000 * 60)) / 1000);
            }
        }, 1000);

        // Lightbox Functions
        function openLightbox(el) {
            const img = el.querySelector('img');
            document.getElementById('lightboxImg').src = img.src;
            document.getElementById('lightboxModal').classList.remove('hidden');
            document.getElementById('lightboxModal').classList.add('flex');
        }
        function closeLightbox() {
            document.getElementById('lightboxModal').classList.add('hidden');
            document.getElementById('lightboxModal').classList.remove('flex');
        }

        // Copy Bank Account
        function copyBankAccount() {
            navigator.clipboard.writeText(invitationData.bank);
            alert("Nomor rekening berhasil disalin: " + invitationData.bank);
        }

        // Add to Calendar
        function addToCalendar() {
            const title = encodeURIComponent("Pernikahan " + invitationData.groom + " & " + invitationData.bride);
            const details = encodeURIComponent("Pawiwahan Adat Jawa di " + invitationData.location);
            const location = encodeURIComponent(invitationData.address);
            window.open(`https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&details=${details}&location=${location}&dates=20261115T010000Z/20261115T070000Z`, '_blank');
        }

        // RSVP Submit
        function submitRSVP(e) {
            e.preventDefault();
            const name = document.getElementById('rsvpName').value;
            const status = document.getElementById('rsvpStatus').value;
            const msg = document.getElementById('rsvpMessage').value;

            // Tambah ke Buku Tamu Lokal
            const list = document.getElementById('guestbookList');
            const item = document.createElement('div');
            item.className = "gebyok-border bg-palaceBlack p-4 rounded-xl space-y-1";
            item.innerHTML = `<div class="flex justify-between items-center text-[10px] text-goldLight/70"><strong>${name} (${status})</strong><span>Baru saja</span></div><p class="text-xs text-parchment">${msg}</p>`;
            list.prepend(item);

            alert("Terima kasih, konfirmasi kehadiran dan doa Anda telah terkirim.");
            document.getElementById('rsvpForm').reset();

            // Kirim ke Google Apps Script jika URL tersedia
            if(invitationData.scriptUrl) {
                fetch(invitationData.scriptUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, status, msg })
                }).catch(err => console.log(err));
            }
        }

        // Share WhatsApp
        function shareInvitationWhatsApp() {
            const text = `Assalamu’alaikum Warahmatullahi Wabarakatuh.\n\nDengan penuh rasa syukur, kami mengundang Bapak/Ibu/Saudara/i untuk menghadiri acara pernikahan kami, ${invitationData.groom} & ${invitationData.bride}.\n\nSilakan buka tautan undangan berikut:\n${window.location.href}\n\nMerupakan suatu kehormatan bagi kami apabila Anda berkenan hadir dan memberikan doa restu. Terima kasih.`;
            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
        }

        // Editor Modal Functions
        function openEditorModal() {
            document.getElementById('editGroom').value = invitationData.groom;
            document.getElementById('editBride').value = invitationData.bride;
            document.getElementById('editDate').value = invitationData.date;
            document.getElementById('editTime').value = invitationData.time;
            document.getElementById('editLocation').value = invitationData.location;
            document.getElementById('editAddress').value = invitationData.address;
            document.getElementById('editBank').value = invitationData.bank;
            document.getElementById('editScriptUrl').value = invitationData.scriptUrl;

            document.getElementById('editorModal').classList.remove('hidden');
            document.getElementById('editorModal').classList.add('flex');
        }
        function closeEditorModal() {
            document.getElementById('editorModal').classList.add('hidden');
            document.getElementById('editorModal').classList.remove('flex');
        }
        function saveEditorData() {
            invitationData.groom = document.getElementById('editGroom').value;
            invitationData.bride = document.getElementById('editBride').value;
            invitationData.date = document.getElementById('editDate').value;
            invitationData.time = document.getElementById('editTime').value;
            invitationData.location = document.getElementById('editLocation').value;
            invitationData.address = document.getElementById('editAddress').value;
            invitationData.bank = document.getElementById('editBank').value;
            invitationData.scriptUrl = document.getElementById('editScriptUrl').value;

            localStorage.setItem('jawa_wayangan_data', JSON.stringify(invitationData));
            applyEditorDataToUI();
            closeEditorModal();
            alert("Data undangan berhasil diperbarui!");
        }
        function applyEditorDataToUI() {
            document.getElementById('coverNames').innerText = invitationData.groom.split(',')[0] + " & " + invitationData.bride.split(',')[0];
            document.getElementById('mainTitleNames').innerText = invitationData.groom.split(',')[0] + " & " + invitationData.bride.split(',')[0];
            document.getElementById('mainDateDisplay').innerText = invitationData.date;
            document.getElementById('groomFullName').innerText = invitationData.groom;
            document.getElementById('brideFullName').innerText = invitationData.bride;
            document.getElementById('akadDay').innerText = invitationData.date;
            document.getElementById('akadTime').innerText = "Pukul " + invitationData.time;
            document.getElementById('akadLocation').innerText = invitationData.location;
            document.getElementById('akadAddress').innerText = invitationData.address;
            document.getElementById('resepsiDay').innerText = invitationData.date;
            document.getElementById('resepsiTime').innerText = "Pukul " + invitationData.time;
            document.getElementById('resepsiLocation').innerText = invitationData.location;
            document.getElementById('resepsiAddress').innerText = invitationData.address;
            document.getElementById('bankAccNum').innerText = invitationData.bank;
        }
    </script>
</body>
