            <div class="space-y-3 max-h-[65vh] overflow-y-auto pr-2 text-xs">
                <div>
                    <label class="font-bold block mb-1">Nama Mempelai Pria</label>
                    <input type="text" id="editGroom" class="w-full p-2.5 rounded-lg border border-goldAntique bg-white" value="Raden Dimas Prayoga, S.T.">
