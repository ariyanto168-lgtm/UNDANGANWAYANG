<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Jawa Wayangan Gold — Pawiwahan Adat Jawa</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        palaceBlack: '#11100E',
                        charcoal: '#1B1814',
                        goldPrimary: '#D4AF62',
                        goldLight: '#F2D58A',
                        goldAntique: '#A77B32',
                        parchment: '#F1E2C3',
                        creamLight: '#FFF7E8',
                        inkBrown: '#49321E',
                        maroonOpt: '#702C28'
                    },
                    fontFamily: {
                        serif: ['Cinzel', 'Playfair Display', 'Georgia', 'serif'],
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    
    <!-- FontAwesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            background-color: #11100E;
            color: #49321E;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }
        .gebyok-border {
            border: 4px double #D4AF62;
            box-shadow: 0 0 20px rgba(212, 175, 98, 0.3), inset 0 0 15px rgba(212, 175, 98, 0.2);
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #F2D58A 0%, #D4AF62 50%, #A77B32 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gold-gradient-bg {
            background: linear-gradient(135deg, #F2D58A 0%, #D4AF62 50%, #A77B32 100%);
        }
        .batik-pattern {
            background-image: radial-gradient(#D4AF62 0.75px, transparent 0.75px), radial-gradient(#D4AF62 0.75px, #F1E2C3 0.75px);
            background-size: 30px 30px;
            background-position: 0 0, 15px 15px;
            opacity: 0.08;
        }
        .parang-pattern {
            background-image: repeating-linear-gradient(45deg, rgba(212,175,98,0.1) 0, rgba(212,175,98,0.1) 10px, transparent 0, transparent 20px);
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #11100E; }
        ::-webkit-scrollbar-thumb { background: #D4AF62; border-radius: 3px; }
    </style>
</head>
<body class="bg-palaceBlack min-h-screen text-inkBrown relative flex flex-col items-center">

    <!-- BACKGROUND WATERMARK / BATIK -->
    <div class="fixed inset-0 batik-pattern pointer-events-none z-0"></div>

    <!-- AUDIO PLAYER (Gamelan Instrumental) -->
    <audio id="bgMusic" loop>
        <source src="https://actions.google.com/sounds/v1/ambiences/asian_market.ogg" type="audio/ogg">
        Your browser does not support the audio element.
    </audio>

    <!-- FLOATING MUSIC & AUTO-SCROLL CONTROL WIDGET -->
    <div id="floatingControls" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2.5 hidden">
        <button id="musicToggleBtn" onclick="toggleMusic()" class="w-12 h-12 rounded-full gold-gradient-bg text-palaceBlack flex items-center justify-center shadow-lg hover:scale-110 transition border-2 border-goldLight" title="Musik Gamelan">
            <i id="musicIcon" class="fa-solid fa-music text-lg animate-pulse"></i>
        </button>
        <button id="autoScrollToggleBtn" onclick="toggleAutoScroll()" class="w-12 h-12 rounded-full bg-palaceBlack text-goldPrimary flex items-center justify-center shadow-lg hover:scale-110 transition border-2 border-goldPrimary" title="Auto Scroll">
            <i id="scrollIcon" class="fa-solid fa-angles-down text-lg"></i>
        </button>
        <button onclick="openEditorModal()" class="w-12 h-12 rounded-full bg-maroonOpt text-parchment flex items-center justify-center shadow-lg hover:scale-110 transition border-2 border-goldPrimary" title="Panel Editor">
            <i class="fa-solid fa-gear text-lg"></i>
        </button>
    </div>

    <!-- MAIN APP CONTAINER (MAX WIDTH MOBILE FRIENDLY) -->
    <main class="w-full max-w-md bg-parchment min-h-screen relative shadow-2xl flex flex-col z-10 overflow-hidden">

        <!-- ========================================== -->
        <!-- COVER PEMBUKA UNDANGAN -->
        <!-- ========================================== -->
        <section id="coverSection" class="absolute inset-0 z-40 bg-palaceBlack text-parchment flex flex-col justify-between p-6 text-center transition-all duration-700 overflow-y-auto">
            <!-- Bingkai Ukiran Gebyok Atas -->
            <div class="absolute top-0 left-0 right-0 h-16 border-b-2 border-goldPrimary flex items-center justify-center parang-pattern">
                <span class="text-goldPrimary text-xs tracking-widest uppercase font-serif">✦ Pawiwahan Adat Jawa ✦</span>
            </div>

            <div class="my-auto pt-16 pb-8 space-y-6 flex flex-col items-center">
                <!-- Ornamen Gunungan Mini -->
                <div class="w-16 h-20 gold-gradient-bg flex items-center justify-center rounded-t-full shadow-lg border border-goldLight animate-bounce">
                    <i class="fa-solid fa-feather text-palaceBlack text-2xl"></i>
                </div>

                <div>
                    <p class="text-goldLight text-xs tracking-[0.3em] uppercase mb-2 font-serif">Undangan Pernikahan</p>
                    <h1 class="text-3xl font-serif font-bold gold-gradient-text">Jawa Wayangan Gold</h1>
                </div>

                <!-- Ilustrasi Wayang Pengantin (Siluet / Artwork Klasik) -->
                <div class="w-48 h-56 gebyok-border rounded-2xl bg-charcoal flex flex-col items-center justify-center relative overflow-hidden shadow-2xl my-4">
                    <div class="absolute inset-0 bg-gradient-to-t from-palaceBlack via-transparent to-transparent opacity-80"></div>
                    <i class="fa-solid fa-chess-queen text-goldPrimary text-6xl mb-2 relative z-10"></i>
                    <p id="coverNames" class="text-goldLight font-serif text-sm font-semibold tracking-wider relative z-10">Dimas & Dewi</p>
                    <span class="text-[10px] text-parchment/70 relative z-10">Pasangan Kekasih</span>
                </div>

                <div class="space-y-1">
                    <p class="text-xs text-parchment/80">Kepada Yth. Bapak/Ibu/Saudara/i</p>
                    <div id="guestBadge" class="bg-charcoal border border-goldPrimary/50 px-4 py-2 rounded-xl text-goldLight font-bold text-sm inline-block shadow">
                        Tamu Undangan Istimewa
                    </div>
                </div>

                <p class="text-xs italic text-parchment/70 max-w-xs">"Dalam Restu dan Doa, kami mengundang kehadiran Anda di hari bahagia kami."</p>

                <button onclick="openInvitation()" class="w-full max-w-xs gold-gradient-bg text-palaceBlack font-serif font-bold py-3.5 px-6 rounded-xl shadow-xl hover:scale-105 active:scale-95 transition flex items-center justify-center gap-3 text-sm tracking-wider uppercase border border-goldLight">
                    <i class="fa-solid fa-envelope-open-text"><span>Buka Undangan</span></i>
                </button>
            </div>

            <!-- Footer Cover -->
            <div class="text-[10px] text-goldLight/60 font-serif tracking-widest pb-2">
                PAWIWAHAN AGUNG • JAWA WAYANGAN GOLD
            </div>
        </section>

        <!-- ========================================== -->
        <!-- KONTEN UTAMA UNDANGAN (ISI) -->
        <!-- ========================================== -->
        <div id="invitationContent" class="opacity-0 transition-opacity duration-1000 flex flex-col flex-grow">

            <!-- HEADER / HERO SECTION -->
            <header class="relative py-12 px-6 text-center bg-charcoal text-parchment border-b-4 border-goldPrimary">
                <div class="absolute top-2 left-2 text-goldPrimary/30 text-2xl"><i class="fa-solid fa-sun"></i></div>
                <div class="absolute top-2 right-2 text-goldPrimary/30 text-2xl"><i class="fa-solid fa-sun"></i></div>
                <p class="text-goldLight text-xs tracking-[0.25em] uppercase font-serif mb-1">Pawiwahan Adat Jawa</p>
                <h2 id="mainTitleNames" class="text-3xl font-serif font-bold gold-gradient-text my-2">Dimas & Dewi</h2>
                <p id="mainDateDisplay" class="text-xs text-parchment/90 font-medium">Minggu, 15 November 2026</p>
            </header>

            <!-- BAGIAN 1 — SALAM PEMBUKA -->
            <section class="py-10 px-6 text-center space-y-4 border-b border-goldPrimary/30 bg-creamLight">
                <div class="w-10 h-10 mx-auto text-goldAntique text-xl"><i class="fa-solid fa-feather-pointed"></i></div>
                <h3 class="font-serif font-bold text-lg text-inkBrown">Assalamu’alaikum Warahmatullahi Wabarakatuh</h3>
                <p class="text-xs text-inkBrown/80 leading-relaxed">
                    Dengan memohon rahmat dan ridho Allah Subhanahu Wa Ta'ala, kami sekeluarga bermaksud menyelenggarakan pernikahan putra-putri kami:
                </p>
                <div class="text-xs italic text-goldAntique font-serif">
                    "Dan di antara tanda-tanda kekuasaan-Nya ialah Dia menciptakan untukmu istri-istri dari jenismu sendiri, supaya kamu cenderung dan merasa tentram kepadanya..." (QS. Ar-Rum: 21)
                </div>
            </section>

            <!-- BAGIAN 2 — PROFIL MEMPELAI -->
            <section class="py-12 px-6 text-center space-y-8 bg-parchment border-b border-goldPrimary/30">
                <h2 class="text-2xl font-serif font-bold gold-gradient-text">Mempelai Berbahagia</h2>
                
                <!-- Mempelai Pria -->
                <div class="gebyok-border p-6 rounded-2xl bg-creamLight shadow-md space-y-3 relative overflow-hidden">
                    <div class="w-28 h-28 mx-auto rounded-full p-1 gold-gradient-bg shadow-lg">
                        <img id="groomPhoto" src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=300" alt="Groom" class="w-full h-full object-cover rounded-full">
                    </div>
                    <h3 id="groomFullName" class="font-serif font-bold text-xl text-inkBrown">Raden Dimas Prayoga, S.T.</h3>
                    <p class="text-xs text-inkBrown/80">Putra tercinta dari:<br><strong id="groomParents">Bapak H. Suryo Kusumo & Ibu Hj. Lestari</strong></p>
                    <a id="groomIG" href="#" target="_blank" class="inline-block text-xs text-goldAntique font-semibold hover:underline"><i class="fa-brands fa-instagram mr-1"></i> @dimas.prayoga</a>
                </div>

                <div class="text-3xl font-serif text-goldAntique font-bold">&</div>

                <!-- Mempelai Wanita -->
                <div class="gebyok-border p-6 rounded-2xl bg-creamLight shadow-md space-y-3 relative overflow-hidden">
                    <div class="w-28 h-28 mx-auto rounded-full p-1 gold-gradient-bg shadow-lg">
                        <img id="bridePhoto" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300" alt="Bride" class="w-full h-full object-cover rounded-full">
                    </div>
                    <h3 id="brideFullName" class="font-serif font-bold text-xl text-inkBrown">Nyai Roro Dewi Sekar Kencana, S.Pd.</h3>
                    <p class="text-xs text-inkBrown/80">Putri tercinta dari:<br><strong id="brideParents">Bapak KRT. Broto Diningrat & Ibu Rr. Sulasmi</strong></p>
                    <a id="brideIG" href="#" target="_blank" class="inline-block text-xs text-goldAntique font-semibold hover:underline"><i class="fa-brands fa-instagram mr-1"></i> @dewi.sekarkencana</a>
                </div>
            </section>

            <!-- BAGIAN 3 — HITUNG MUNDUR (COUNTDOWN) -->
            <section class="py-10 px-6 text-center bg-charcoal text-parchment space-y-6">
                <h3 class="font-serif font-bold text-lg gold-gradient-text">Menuju Hari Bahagia</h3>
                <div class="grid grid-cols-4 gap-3 max-w-xs mx-auto">
                    <div class="gebyok-border p-3 rounded-xl bg-palaceBlack">
                        <span id="days" class="text-2xl font-bold font-serif text-goldLight">00</span>
                        <p class="text-[10px] uppercase text-parchment/70">Hari</p>
                    </div>
                    <div class="gebyok-border p-3 rounded-xl bg-palaceBlack">
                        <span id="hours" class="text-2xl font-bold font-serif text-goldLight">00</span>
                        <p class="text-[10px] uppercase text-parchment/70">Jam</p>
                    </div>
                    <div class="gebyok-border p-3 rounded-xl bg-palaceBlack">
                        <span id="minutes" class="text-2xl font-bold font-serif text-goldLight">00</span>
                        <p class="text-[10px] uppercase text-parchment/70">Menit</p>
                    </div>
                    <div class="gebyok-border p-3 rounded-xl bg-palaceBlack">
                        <span id="seconds" class="text-2xl font-bold font-serif text-goldLight">00</span>
                        <p class="text-[10px] uppercase text-parchment/70">Detik</p>
                    </div>
                </div>
                <div>
                    <button onclick="addToCalendar()" class="bg-goldAntique hover:bg-goldPrimary text-palaceBlack text-xs font-bold py-2.5 px-5 rounded-xl shadow transition">
                        <i class="fa-regular fa-calendar-plus mr-2"></i> Tambah ke Kalender
                    </button>
                </div>
            </section>

            <!-- BAGIAN 4 & 5 — AKAD NIKAH & RESEPSI -->
            <section class="py-12 px-6 space-y-8 bg-parchment border-b border-goldPrimary/30">
                <h2 class="text-2xl font-serif font-bold text-center gold-gradient-text">Rangkaian Acara</h2>

                <!-- Akad Nikah -->
                <div class="gebyok-border bg-creamLight p-6 rounded-2xl shadow space-y-4 relative">
                    <div class="absolute -top-3 left-6 gold-gradient-bg text-palaceBlack px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
                        Akad Nikah
                    </div>
                    <div class="flex items-start gap-4 pt-2">
                        <div class="w-10 h-10 rounded-xl bg-goldAntique/20 text-goldAntique flex items-center justify-center shrink-0 text-lg">
                            <i class="fa-regular fa-calendar"></i>
                        </div>
                        <div>
                            <h4 id="akadDay" class="font-bold text-sm text-inkBrown">Minggu, 15 November 2026</h4>
                            <p id="akadTime" class="text-xs text-inkBrown/80">Pukul 08.00 WIB s.d. Selesai</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-xl bg-goldAntique/20 text-goldAntique flex items-center justify-center shrink-0 text-lg">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <div>
                            <h4 id="akadLocation" class="font-bold text-sm text-inkBrown">Pendopo Agung Keraton</h4>
                            <p id="akadAddress" class="text-xs text-inkBrown/80">Jl. Pariwisata Budaya No. 1, Semarang, Jawa Tengah</p>
                        </div>
                    </div>
                </div>

                <!-- Resepsi -->
                <div class="gebyok-border bg-creamLight p-6 rounded-2xl shadow space-y-4 relative">
                    <div class="absolute -top-3 left-6 gold-gradient-bg text-palaceBlack px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
                        Resepsi Pernikahan
                    </div>
                    <div class="flex items-start gap-4 pt-2">
                        <div class="w-10 h-10 rounded-xl bg-goldAntique/20 text-goldAntique flex items-center justify-center shrink-0 text-lg">
                            <i class="fa-regular fa-calendar"></i>
                        </div>
                        <div>
                            <h4 id="resepsiDay" class="font-bold text-sm text-inkBrown">Minggu, 15 November 2026</h4>
                            <p id="resepsiTime" class="text-xs text-inkBrown/80">Pukul 11.00 - 14.00 WIB</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-xl bg-goldAntique/20 text-goldAntique flex items-center justify-center shrink-0 text-lg">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <div>
                            <h4 id="resepsiLocation" class="font-bold text-sm text-inkBrown">Pendopo Agung Keraton</h4>
                            <p id="resepsiAddress" class="text-xs text-inkBrown/80">Jl. Pariwisata Budaya No. 1, Semarang, Jawa Tengah</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- BAGIAN 6 — LOKASI & PETA -->
            <section class="py-10 px-6 text-center bg-charcoal text-parchment space-y-4">
                <h3 class="font-serif font-bold text-lg gold-gradient-text">Peta Lokasi Acara</h3>
                <p class="text-xs text-parchment/80">Gunakan tautan di bawah untuk navigasi langsung menuju lokasi.</p>
                <div class="w-full h-48 rounded-2xl overflow-hidden gebyok-border bg-palaceBlack relative">
                    <iframe id="mapIframe" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" src="https://maps.google.com/maps?q=Semarang&t=&z=13&ie=UTF8&iwloc=&output=embed"></iframe>
                </div>
                <a id="mapLinkBtn" href="https://maps.google.com/?q=Semarang" target="_blank" class="inline-block w-full max-w-xs gold-gradient-bg text-palaceBlack font-bold py-3 rounded-xl text-xs uppercase shadow transition hover:scale-105">
                    <i class="fa-solid fa-map-location-dot mr-2"></i> Buka Google Maps
                </a>
            </section>

            <!-- BAGIAN 7 — KISAH CINTA (TIMELINE) -->
            <section class="py-12 px-6 bg-parchment border-b border-goldPrimary/30 space-y-8">
                <h2 class="text-2xl font-serif font-bold text-center gold-gradient-text">Kisah Cinta Kami</h2>
                <div class="space-y-6 border-l-2 border-goldAntique ml-4 pl-6 relative">
                    <div class="relative space-y-1">
                        <div class="absolute -left-[31px] top-0 w-4 h-4 rounded-full gold-gradient-bg border-2 border-palaceBlack"></div>
                        <span class="text-[10px] bg-goldAntique text-parchment px-2 py-0.5 rounded-full font-bold">2021</span>
                        <h4 class="font-bold text-sm text-inkBrown">Pertemuan Pertama</h4>
                        <p class="text-xs text-inkBrown/80">Bertemu di sebuah acara pameran budaya dan kesenian tradisional Jawa di Semarang.</p>
                    </div>
                    <div class="relative space-y-1">
                        <div class="absolute -left-[31px] top-0 w-4 h-4 rounded-full gold-gradient-bg border-2 border-palaceBlack"></div>
                        <span class="text-[10px] bg-goldAntique text-parchment px-2 py-0.5 rounded-full font-bold">2023</span>
                        <h4 class="font-bold text-sm text-inkBrown">Mulai Menjalin Kasih</h4>
                        <p class="text-xs text-inkBrown/80">Menyatukan visi dan komitmen untuk melangkah ke jenjang yang lebih serius.</p>
                    </div>
                    <div class="relative space-y-1">
                        <div class="absolute -left-[31px] top-0 w-4 h-4 rounded-full gold-gradient-bg border-2 border-palaceBlack"></div>
                        <span class="text-[10px] bg-goldAntique text-parchment px-2 py-0.5 rounded-full font-bold">2026</span>
                        <h4 class="font-bold text-sm text-inkBrown">Lamaran & Pernikahan Agung</h4>
                        <p class="text-xs text-inkBrown/80">Acara lamaran resmi keluarga besar dan dilanjutkan hari suci pernikahan kami.</p>
                    </div>
                </div>
            </section>

            <!-- BAGIAN 8 — GALERI FOTO -->
            <section class="py-12 px-6 bg-creamLight border-b border-goldPrimary/30 space-y-6">
                <h2 class="text-2xl font-serif font-bold text-center gold-gradient-text">Galeri Kenangan</h2>
                <div class="grid grid-cols-2 gap-3">
                    <div onclick="openLightbox(this)" class="gebyok-border rounded-xl overflow-hidden aspect-square cursor-pointer hover:opacity-90 transition">
                        <img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=400" class="w-full h-full object-cover">
                    </div>
                    <div onclick="openLightbox(this)" class="gebyok-border rounded-xl overflow-hidden aspect-square cursor-pointer hover:opacity-90 transition">
                        <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=400" class="w-full h-full object-cover">
                    </div>
                    <div onclick="openLightbox(this)" class="gebyok-border rounded-xl overflow-hidden aspect-square cursor-pointer hover:opacity-90 transition">
                        <img src="https://images.unsplash.com/photo-1583939003579-730e3918a45a?w=400" class="w-full h-full object-cover">
                    </div>
                    <div onclick="openLightbox(this)" class="gebyok-border rounded-xl overflow-hidden aspect-square cursor-pointer hover:opacity-90 transition">
                        <img src="https://images.unsplash.com/photo-1520854221256-17451cc331bf?w=400" class="w-full h-full object-cover">
                    </div>
                </div>
            </section>

            <!-- Lightbox Modal -->
            <div id="lightboxModal" class="fixed inset-0 z-50 bg-palaceBlack/90 hidden items-center justify-center p-4">
                <button onclick="closeLightbox()" class="absolute top-4 right-4 text-parchment text-2xl font-bold"><i class="fa-solid fa-xmark"></i></button>
                <img id="lightboxImg" src="" class="max-w-full max-h-[80vh] rounded-2xl gebyok-border">
            </div>

            <!-- BAGIAN 9 — RSVP KEHADIRAN -->
            <section class="py-12 px-6 bg-parchment border-b border-goldPrimary/30 space-y-6">
                <h2 class="text-2xl font-serif font-bold text-center gold-gradient-text">Konfirmasi Kehadiran (RSVP)</h2>
                <form id="rsvpForm" onsubmit="submitRSVP(event)" class="gebyok-border bg-creamLight p-6 rounded-2xl space-y-4 shadow">
                    <div>
                        <label class="block text-xs font-bold text-inkBrown mb-1">Nama Lengkap Tamu</label>
                        <input type="text" id="rsvpName" required placeholder="Masukkan nama Anda..." class="w-full p-3 rounded-xl border border-goldAntique/50 bg-parchment text-xs text-inkBrown focus:outline-none focus:border-goldPrimary">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-inkBrown mb-1">Status Kehadiran</label>
                        <select id="rsvpStatus" class="w-full p-3 rounded-xl border border-goldAntique/50 bg-parchment text-xs text-inkBrown focus:outline-none focus:border-goldPrimary">
                            <option value="Hadir">Hadir (Menyaksikan Langsung)</option>
                            <option value="Tidak Hadir">Berhalangan Hadir</option>
                            <option value="Masih Ragu">Masih Ragu-ragu</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-inkBrown mb-1">Jumlah Tamu</label>
                        <select id="rsvpCount" class="w-full p-3 rounded-xl border border-goldAntique/50 bg-parchment text-xs text-inkBrown focus:outline-none focus:border-goldPrimary">
                            <option value="1 Orang">1 Orang</option>
                            <option value="2 Orang">2 Orang</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-inkBrown mb-1">Pesan / Doa Restu</label>
                        <textarea id="rsvpMessage" rows="3" placeholder="Tuliskan pesan atau doa untuk mempelai..." class="w-full p-3 rounded-xl border border-goldAntique/50 bg-parchment text-xs text-inkBrown focus:outline-none focus:border-goldPrimary"></textarea>
                    </div>
                    <button type="submit" class="w-full gold-gradient-bg text-palaceBlack font-bold py-3 rounded-xl text-xs uppercase shadow transition hover:scale-105">
                        Kirim Konfirmasi RSVP
                    </button>
                </form>
            </section>

            <!-- BAGIAN 10 — BUKU TAMU & UCAPAN -->
            <section class="py-12 px-6 bg-charcoal text-parchment space-y-6">
                <h2 class="text-2xl font-serif font-bold text-center gold-gradient-text">Buku Tamu & Ucapan</h2>
                <div id="guestbookList" class="space-y-4 max-h-80 overflow-y-auto pr-1">
                    <!-- Dinamis Diisi Script -->
