<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Jawa Wayangan Gold — Pawiwahan Adat Jawa</title>
    
    <!-- PWA & Mobile Meta Tags -->
    <link rel="manifest" href="./manifest.json">
    <meta name="theme-color" content="#11100E">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        palaceBlack: '#11100E',
                        charcoal: '#1B1814',
                        goldPrimary: '#D4AF62',
                        goldLight: '#F2D58A',
                        goldAntique: '#A77B32',
                        parchment: '#F1E2C3',
                        creamLight: '#FFF7E8',
                        inkBrown: '#49321E',
                        maroonOpt: '#702C28'
                    },
                    fontFamily: {
                        serif: ['Cinzel', 'Playfair Display', 'Georgia', 'serif'],
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    
    <!-- FontAwesome, Google Fonts, & QR Code Library -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    
    <style>
        body {
            background-color: #11100E;
            color: #49321E;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }
        .gebyok-border {
            border: 4px double #D4AF62;
            box-shadow: 0 0 20px rgba(212, 175, 98, 0.3), inset 0 0 15px rgba(212, 175, 98, 0.2);
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #F2D58A 0%, #D4AF62 50%, #A77B32 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gold-gradient-bg {
            background: linear-gradient(135deg, #F2D58A 0%, #D4AF62 50%, #A77B32 100%);
        }
        .batik-pattern {
            background-image: radial-gradient(#D4AF62 0.75px, transparent 0.75px), radial-gradient(#D4AF62 0.75px, #F1E2C3 0.75px);
            background-size: 30px 30px;
            background-position: 0 0, 15px 15px;
            opacity: 0.08;
        }
        .parang-pattern {
            background-image: repeating-linear-gradient(45deg, rgba(212,175,98,0.1) 0, rgba(212,175,98,0.1) 10px, transparent 0, transparent 20px);
        }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #11100E; }
        ::-webkit-scrollbar-thumb { background: #D4AF62; border-radius: 3px; }
    </style>
</head>
<body class="bg-palaceBlack min-h-screen text-inkBrown relative flex flex-col items-center">

    <!-- BACKGROUND WATERMARK -->
    <div class="fixed inset-0 batik-pattern pointer-events-none z-0"></div>

    <!-- AUDIO PLAYER -->
    <audio id="bgMusic" loop>
        <source src="https://actions.google.com/sounds/v1/ambiences/asian_market.ogg" type="audio/ogg">
    </audio>

    <!-- FLOATING CONTROLS -->
    <div id="floatingControls" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2.5 hidden">
        <button id="musicToggleBtn" onclick="toggleMusic()" class="w-12 h-12 rounded-full gold-gradient-bg text-palaceBlack flex items-center justify-center shadow-lg hover:scale-110 transition border-2 border-goldLight" title="Musik Gamelan">
            <i id="musicIcon" class="fa-solid fa-music text-lg animate-pulse"></i>
        </button>
        <button id="autoScrollToggleBtn" onclick="toggleAutoScroll()" class="w-12 h-12 rounded-full bg-palaceBlack text-goldPrimary flex items-center justify-center shadow-lg hover:scale-110 transition border-2 border-goldPrimary" title="Auto Scroll">
            <i id="scrollIcon" class="fa-solid fa-angles-down text-lg"></i>
        </button>
        <button onclick="openEditorModal()" class="w-12 h-12 rounded-full bg-maroonOpt text-parchment flex items-center justify-center shadow-lg hover:scale-110 transition border-2 border-goldPrimary" title="Panel Editor">
            <i class="fa-solid fa-gear text-lg"></i>
        </button>
    </div>

    <!-- MAIN APP CONTAINER -->
    <main class="w-full max-w-md bg-parchment min-h-screen relative shadow-2xl flex flex-col z-10 overflow-hidden">

        <!-- COVER PEMBUKA -->
        <section id="coverSection" class="absolute inset-0 z-40 bg-palaceBlack text-parchment flex flex-col justify-between p-6 text-center transition-all duration-700 overflow-y-auto">
            <div class="absolute top-0 left-0 right-0 h-16 border-b-2 border-goldPrimary flex items-center justify-center parang-pattern">
                <span class="text-goldPrimary text-xs tracking-widest uppercase font-serif">✦ Pawiwahan Adat Jawa ✦</span>
            </div>

            <div class="my-auto pt-16 pb-8 space-y-6 flex flex-col items-center">
                <div class="w-16 h-20 gold-gradient-bg flex items-center justify-center rounded-t-full shadow-lg border border-goldLight animate-bounce">
                    <i class="fa-solid fa-feather text-palaceBlack text-2xl"></i>
                </div>

                <div>
                    <p class="text-goldLight text-xs tracking-[0.3em] uppercase mb-2 font-serif">Undangan Pernikahan</p>
                    <h1 class="text-3xl font-serif font-bold gold-gradient-text">Jawa Wayangan Gold</h1>
                </div>

                <div class="w-48 h-56 gebyok-border rounded-2xl bg-charcoal flex flex-col items-center justify-center relative overflow-hidden shadow-2xl my-4">
                    <div class="absolute inset-0 bg-gradient-to-t from-palaceBlack via-transparent to-transparent opacity-80"></div>
                    <i class="fa-solid fa-chess-queen text-goldPrimary text-6xl mb-2 relative z-10"></i>
                    <p id="coverNames" class="text-goldLight font-serif text-sm font-semibold tracking-wider relative z-10">Dimas & Dewi</p>
                    <span class="text-[10px] text-parchment/70 relative z-10">Pasangan Kekasih</span>
                </div>

                <div class="space-y-1">
                    <p class="text-xs text-parchment/80">Kepada Yth. Bapak/Ibu/Saudara/i</p>
                    <div id="guestBadge" class="bg-charcoal border border-goldPrimary/50 px-4 py-2 rounded-xl text-goldLight font-bold text-sm inline-block shadow">
                        Tamu Undangan Istimewa
                    </div>
                </div>

                <p class="text-xs italic text-parchment/70 max-w-xs">"Dalam Restu dan Doa, kami mengundang kehadiran Anda di hari bahagia kami."</p>

                <button onclick="openInvitation()" class="w-full max-w-xs gold-gradient-bg text-palaceBlack font-serif font-bold py-3.5 px-6 rounded-xl shadow-xl hover:scale-105 active:scale-95 transition flex items-center justify-center gap-3 text-sm tracking-wider uppercase border border-goldLight">
                    <i class="fa-solid fa-envelope-open-text"><span>Buka Undangan</span></i>
                </button>
            </div>

            <div class="text-[10px] text-goldLight/60 font-serif tracking-widest pb-2">
                PAWIWAHAN AGUNG • JAWA WAYANGAN GOLD
            </div>
        </section>

        <!-- ISI UNDANGAN -->
        <div id="invitationContent" class="opacity-0 transition-opacity duration-1000 flex flex-col flex-grow">

            <!-- HERO SECTION -->
            <header class="relative py-12 px-6 text-center bg-charcoal text-parchment border-b-4 border-goldPrimary">
                <p class="text-goldLight text-xs tracking-[0.25em] uppercase font-serif mb-1">Pawiwahan Adat Jawa</p>
                <h2 id="mainTitleNames" class="text-3xl font-serif font-bold gold-gradient-text my-2">Dimas & Dewi</h2>
                <p id="mainDateDisplay" class="text-xs text-parchment/90 font-medium">Minggu, 15 November 2026</p>
            </header>

            <!-- SALAM PEMBUKA -->
            <section class="py-10 px-6 text-center space-y-4 border-b border-goldPrimary/30 bg-creamLight">
                <h3 class="font-serif font-bold text-lg text-inkBrown">Assalamu’alaikum Warahmatullahi Wabarakatuh</h3>
                <p class="text-xs text-inkBrown/80 leading-relaxed">
                    Dengan memohon rahmat dan ridho Allah Subhanahu Wa Ta'ala, kami sekeluarga bermaksud menyelenggarakan pernikahan putra-putri kami.
                </p>
            </section>

            <!-- PROFIL MEMPELAI -->
            <section class="py-12 px-6 text-center space-y-8 bg-parchment border-b border-goldPrimary/30">
                <h2 class="text-2xl font-serif font-bold gold-gradient-text">Mempelai Berbahagia</h2>
                <div class="gebyok-border p-6 rounded-2xl bg-creamLight shadow-md space-y-3">
                    <h3 id="groomFullName" class="font-serif font-bold text-xl text-inkBrown">Raden Dimas Prayoga, S.T.</h3>
                    <p id="groomParents" class="text-xs text-inkBrown/80">Putra dari Bapak H. Suryo Kusumo & Ibu Hj. Lestari</p>
                </div>
                <div class="text-3xl font-serif text-goldAntique font-bold">&</div>
                <div class="gebyok-border p-6 rounded-2xl bg-creamLight shadow-md space-y-3">
                    <h3 id="brideFullName" class="font-serif font-bold text-xl text-inkBrown">Nyai Roro Dewi Sekar Kencana, S.Pd.</h3>
                    <p id="brideParents" class="text-xs text-inkBrown/80">Putri dari Bapak KRT. Broto Diningrat & Ibu Rr. Sulasmi</p>
                </div>
            </section>

            <!-- HITUNG MUNDUR -->
            <section class="py-10 px-6 text-center bg-charcoal text-parchment space-y-6">
                <h3 class="font-serif font-bold text-lg gold-gradient-text">Menuju Hari Bahagia</h3>
                <div class="grid grid-cols-4 gap-3 max-w-xs mx-auto">
                    <div class="gebyok-border p-3 rounded-xl bg-palaceBlack"><span id="days" class="text-2xl font-bold font-serif text-goldLight">00</span><p class="text-[10px] uppercase">Hari</p></div>
                    <div class="gebyok-border p-3 rounded-xl bg-palaceBlack"><span id="hours" class="text-2xl font-bold font-serif text-goldLight">00</span><p class="text-[10px] uppercase">Jam</p></div>
                    <div class="gebyok-border p-3 rounded-xl bg-palaceBlack"><span id="minutes" class="text-2xl font-bold font-serif text-goldLight">00</span><p class="text-[10px] uppercase">Menit</p></div>
                    <div class="gebyok-border p-3 rounded-xl bg-palaceBlack"><span id="seconds" class="text-2xl font-bold font-serif text-goldLight">00</span><p class="text-[10px] uppercase">Detik</p></div>
                </div>
                <button onclick="addToCalendar()" class="bg-goldAntique text-palaceBlack text-xs font-bold py-2.5 px-5 rounded-xl shadow">Tambah ke Kalender</button>
            </section>

            <!-- AKAD & RESEPSI -->
            <section class="py-12 px-6 space-y-8 bg-parchment border-b border-goldPrimary/30">
                <h2 class="text-2xl font-serif font-bold text-center gold-gradient-text">Rangkaian Acara</h2>
                <div class="gebyok-border bg-creamLight p-6 rounded-2xl space-y-2">
                    <h4 class="font-bold text-sm text-inkBrown">Akad & Resepsi</h4>
                    <p id="eventDateDisplay" class="text-xs text-inkBrown/80">Minggu, 15 November 2026 (08.00 WIB)</p>
                    <p id="eventLocationDisplay" class="text-xs text-inkBrown/80">Pendopo Agung Keraton, Semarang</p>
                </div>
            </section>

            <!-- RSVP & BUKU TAMU -->
            <section class="py-12 px-6 bg-parchment border-b border-goldPrimary/30 space-y-6">
                <h2 class="text-2xl font-serif font-bold text-center gold-gradient-text">Konfirmasi Kehadiran & Ucapan</h2>
                <form id="rsvpForm" onsubmit="submitRSVP(event)" class="gebyok-border bg-creamLight p-6 rounded-2xl space-y-4">
                    <input type="text" id="rsvpName" required placeholder="Nama Tamu..." class="w-full p-3 rounded-xl border border-goldAntique bg-parchment text-xs">
                    <select id="rsvpStatus" class="w-full p-3 rounded-xl border border-goldAntique bg-parchment text-xs">
                        <option value="Hadir">Hadir</option>
                        <option value="Tidak Hadir">Tidak Hadir</option>
                    </select>
                    <textarea id="rsvpMessage" rows="3" placeholder="Tuliskan ucapan atau doa..." class="w-full p-3 rounded-xl border border-goldAntique bg-parchment text-xs"></textarea>
                    <button type="submit" class="w-full gold-gradient-bg text-palaceBlack font-bold py-3 rounded-xl text-xs uppercase shadow">Kirim RSVP & Ucapan</button>
                </form>
            </section>

            <!-- QR CODE TAMU -->
            <section class="py-12 px-6 bg-creamLight text-center space-y-4 border-b border-goldPrimary/30">
                <h3 class="font-serif font-bold text-lg gold-gradient-text text-inkBrown">QR Code Buku Tamu</h3>
                <div id="qrcode" class="mx-auto w-32 h-32 bg-white p-2 gebyok-border rounded-xl flex items-center justify-center"></div>
                <p class="text-xs text-inkBrown/80">Tunjukkan QR Code ini kepada penerima tamu saat hadir di lokasi.</p>
            </section>

            <!-- HADIAH -->
            <section class="py-12 px-6 bg-parchment border-b border-goldPrimary/30 space-y-4 text-center">
                <h2 class="text-2xl font-serif font-bold gold-gradient-text">Tanda Kasih</h2>
                <p id="bankDisplay" class="text-lg font-mono font-bold text-goldAntique">BCA: 1234567890 (a.n. Dimas)</p>
                <button onclick="copyBankAccount()" class="bg-goldAntique text-palaceBlack text-xs font-bold py-2 px-4 rounded-xl">Salin Rekening</button>
            </section>

            <!-- PENUTUP -->
            <section class="py-14 px-6 text-center bg-palaceBlack text-parchment space-y-6">
                <h3 class="font-serif font-bold text-xl gold-gradient-text">Matur Nuwun</h3>
                <button onclick="shareWhatsApp()" class="w-full max-w-xs bg-emerald-600 text-white font-bold py-3 rounded-xl text-xs uppercase">Bagikan Undangan</button>
            </section>

        </div>
    </main>

    <!-- PANEL EDITOR -->
    <div id="editorModal" class="fixed inset-0 z-50 bg-palaceBlack/90 hidden items-center justify-center p-4 overflow-y-auto">
        <div class="bg-parchment w-full max-w-md rounded-2xl gebyok-border p-6 space-y-4 my-auto text-inkBrown">
            <h3 class="font-serif font-bold text-base gold-gradient-text">Panel Editor Proyek</h3>
            <div class="space-y-3 text-xs max-h-[60vh] overflow-y-auto pr-2">
                <input type="text" id="editProjectId" class="w-full p-2.5 rounded-lg border border-goldAntique bg-white" placeholder="ID Proyek (unik, misal: dimas_dewi)">
                <input type="text" id="editGroom" class="w-full p-2.5 rounded-lg border border-goldAntique bg-white" placeholder="Nama Mempelai Pria">
                <input type="text" id="editBride" class="w-full p-2.5 rounded-lg border border-goldAntique bg-white" placeholder="Nama Mempelai Wanita">
                <input type="text" id="editDate" class="w-full p-2.5 rounded-lg border border-goldAntique bg-white" placeholder="Tanggal Acara">
                <input type="text" id="editLocation" class="w-full p-2.5 rounded-lg border border-goldAntique bg-white" placeholder="Lokasi">
                <input type="text" id="editBank" class="w-full p-2.5 rounded-lg border border-goldAntique bg-white" placeholder="Nomor Rekening">
                <input type="text" id="editScriptUrl" class="w-full p-2.5 rounded-lg border border-goldAntique bg-white" placeholder="Google Apps Script Web App URL">
            </div>
            <div class="flex gap-2">
                <button onclick="saveProjectToCloud()" class="w-full gold-gradient-bg text-palaceBlack font-bold py-2.5 rounded-xl uppercase">Simpan ke Google Sheets</button>
                <button onclick="closeEditorModal()" class="w-full bg-charcoal text-parchment font-bold py-2.5 rounded-xl uppercase">Tutup</button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Default project dengan URL GAS Anda yang sudah tersemat otomatis
        let currentProject = {
            projectId: "proj_dimas_dewi",
            groom: "Raden Dimas Prayoga, S.T.",
            bride: "Nyai Roro Dewi Sekar Kencana, S.Pd.",
            date: "Minggu, 15 November 2026",
            location: "Pendopo Agung Keraton, Semarang",
            bank: "BCA: 1234567890 (a.n. Dimas)",
            scriptUrl: "https://script.google.com/macros/s/AKfycbxFophoZEnXln6iNy76I072JcpklP2b0oTQzK3GtrLEW7BcAzMRlB3Q5vL_p33i0jmb/exec"
        };

        // Cek Parameter URL ?id=...
        const urlParams = new URLSearchParams(window.location.search);
        const urlProjectId = urlParams.get('id');
        const guestTo = urlParams.get('to');

        if(guestTo) {
            document.getElementById('guestBadge').innerText = decodeURIComponent(guestTo);
        }

        if(urlProjectId) {
            loadProjectFromCloud(urlProjectId);
        } else if(localStorage.getItem('jawa_wayangan_current')) {
            currentProject = JSON.parse(localStorage.getItem('jawa_wayangan_current'));
            applyDataToUI();
        } else {
            applyDataToUI();
        }

        // Generate QR Code untuk Tamu
        new QRCode(document.getElementById("qrcode"), {
            text: window.location.href,
            width: 110,
            height: 110
        });

        function openInvitation() {
            const cover = document.getElementById('coverSection');
            cover.style.transform = 'translateY(-100%)';
            setTimeout(() => cover.style.display = 'none', 700);
            document.getElementById('invitationContent').classList.remove('opacity-0');
            document.getElementById('floatingControls').classList.remove('hidden');
            document.getElementById('bgMusic').play().catch(e => console.log(e));
        }

        function toggleMusic() {
            const audio = document.getElementById('bgMusic');
            const icon = document.getElementById('musicIcon');
            if(audio.paused) { audio.play(); icon.className = "fa-solid fa-music text-lg animate-pulse text-palaceBlack"; }
            else { audio.pause(); icon.className = "fa-solid fa-volume-xmark text-lg text-palaceBlack"; }
        }

        let isScrolling = false, scrollInterval = null;
        function toggleAutoScroll() {
            const icon = document.getElementById('scrollIcon');
            if(!isScrolling) {
                isScrolling = true;
                icon.className = "fa-solid fa-pause text-lg";
                scrollInterval = setInterval(() => {
                    window.scrollBy({ top: 1, behavior: 'smooth' });
                    if((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 10) stopAutoScroll();
                }, 30);
            } else { stopAutoScroll(); }
        }
        function stopAutoScroll() {
            isScrolling = false;
            clearInterval(scrollInterval);
            document.getElementById('scrollIcon').className = "fa-solid fa-angles-down text-lg";
        }
        window.addEventListener('wheel', () => { if(isScrolling) stopAutoScroll(); });

        function applyDataToUI() {
            document.getElementById('coverNames').innerText = currentProject.groom.split(',')[0] + " & " + currentProject.bride.split(',')[0];
            document.getElementById('mainTitleNames').innerText = currentProject.groom.split(',')[0] + " & " + currentProject.bride.split(',')[0];
            document.getElementById('mainDateDisplay').innerText = currentProject.date;
            document.getElementById('groomFullName').innerText = currentProject.groom;
            document.getElementById('brideFullName').innerText = currentProject.bride;
            document.getElementById('eventDateDisplay').innerText = currentProject.date;
            document.getElementById('eventLocationDisplay').innerText = currentProject.location;
            document.getElementById('bankDisplay').innerText = currentProject.bank;
        }

        function openEditorModal() {
            document.getElementById('editProjectId').value = currentProject.projectId;
            document.getElementById('editGroom').value = currentProject.groom;
            document.getElementById('editBride').value = currentProject.bride;
            document.getElementById('editDate').value = currentProject.date;
            document.getElementById('editLocation').value = currentProject.location;
            document.getElementById('editBank').value = currentProject.bank;
            document.getElementById('editScriptUrl').value = currentProject.scriptUrl;
            document.getElementById('editorModal').classList.remove('hidden');
            document.getElementById('editorModal').classList.add('flex');
        }

        function closeEditorModal() {
            document.getElementById('editorModal').classList.add('hidden');
            document.getElementById('editorModal').classList.remove('flex');
        }

        function saveProjectToCloud() {
            currentProject.projectId = document.getElementById('editProjectId').value || "proj_" + Date.now();
            currentProject.groom = document.getElementById('editGroom').value;
            currentProject.bride = document.getElementById('editBride').value;
            currentProject.date = document.getElementById('editDate').value;
            currentProject.location = document.getElementById('editLocation').value;
            currentProject.bank = document.getElementById('editBank').value;
            currentProject.scriptUrl = document.getElementById('editScriptUrl').value;

            localStorage.setItem('jawa_wayangan_current', JSON.stringify(currentProject));
            applyDataToUI();

            if(currentProject.scriptUrl) {
                fetch(currentProject.scriptUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'save_project', projectId: currentProject.projectId, config: currentProject })
                }).then(() => alert("Proyek berhasil disimpan ke Cloud Google Sheets & LocalStorage!")).catch(() => alert("Gagal menyimpan ke cloud."));
            } else {
                alert("Proyek disimpan secara lokal.");
            }
            closeEditorModal();
        }

        function loadProjectFromCloud(id) {
            if(currentProject.scriptUrl) {
                fetch(`${currentProject.scriptUrl}?action=load_project&projectId=${id}`)
                    .then(res => res.json())
                    .then(res => {
                        if(res.status === 'success') {
                            currentProject = res.data;
                            applyDataToUI();
                        }
                    })
                    .catch(err => console.log("Gagal memuat dari cloud:", err));
            }
        }

        function submitRSVP(e) {
            e.preventDefault();
            const name = document.getElementById('rsvpName').value;
            const status = document.getElementById('rsvpStatus').value;
            const msg = document.getElementById('rsvpMessage').value;

            alert("Terima kasih, konfirmasi kehadiran dan ucapan Anda telah tercatat.");
            document.getElementById('rsvpForm').reset();

            if(currentProject.scriptUrl) {
                fetch(currentProject.scriptUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'submit_rsvp', projectId: currentProject.projectId, name, status, count: '1', msg })
                });
                fetch(currentProject.scriptUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'submit_guestbook', projectId: currentProject.projectId, sender: name, msg })
                });
            }
        }

        function copyBankAccount() {
            navigator.clipboard.writeText(currentProject.bank);
            alert("Informasi tanda kasih berhasil disalin.");
        }

        function shareWhatsApp() {
            const url = `${window.location.origin}${window.location.pathname}?id=${currentProject.projectId}`;
            const text = `Assalamu’alaikum Warahmatullahi Wabarakatuh.\n\nKami mengundang Bapak/Ibu/Saudara/i untuk menghadiri pernikahan ${currentProject.groom} & ${currentProject.bride}.\n\nBuka tautan berikut:\n${url}\n\nTerima kasih atas doa restunya.`;
            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
        }
    </script>
</body>
</html>
