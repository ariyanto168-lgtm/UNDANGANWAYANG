    <!-- ========================================== -->
    <!-- PANEL EDITOR MODAL (EDITOR LENGKAP) -->
    <!-- ========================================== -->
    <div id="editorModal" class="fixed inset-0 z-50 bg-palaceBlack/90 hidden items-center justify-center p-4 overflow-y-auto">
        <div class="bg-parchment w-full max-w-md rounded-2xl gebyok-border p-6 space-y-4 my-auto relative text-inkBrown">
            <div class="flex justify-between items-center border-b border-goldAntique/30 pb-3">
